<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>TodoList</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />
</head>
<body>
    <div class="bg-primary text-white p-3">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center">
                <a href="/home/index" class="text-white text-decoration-none fs-4 fw-bold">TodoList</a>
                <div>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <span class="me-3">Welcome, <strong>@User.Identity.Name</strong></span>
                        <form action="/Account/Logout" method="post" class="d-inline">
                            <button class="btn btn-danger btn-sm" type="submit">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn btn-light btn-sm">Login</a>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row m-3">
        <div class="col-md-3">
            <ul class="list-group">
                <li class="list-group-item">
                    <a href="/home/index" class="text-decoration-none">Home</a>
                </li>
                <li class="list-group-item">
                    <a href="/About/index" class="text-decoration-none">About</a>
                </li>
            </ul>
        </div>
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
