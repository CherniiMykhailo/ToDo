@model IEnumerable<TodoListApp.WebApp.Models.ViewModels.ToDoViewModel>

@{
    var categories = new List<string> { "Work", "Home", "Exercise", "Shopping", "Contact" };
}

<h2>Filter by Category</h2>

<form method="get" action="/Category/Index">
    <select name="category" class="form-select">
        <option value="">All</option>
        @foreach (var category in categories)
        {
            <option value="@category">@category</option>
        }
    </select>
    <div class="col-auto mt-2">
        <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    </div>
</form>

<h2>Tasks</h2>

<table class="table table-hover table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Description</th>
            <th>Due Date</th>
            <th>Category</th>
            <th>Status</th>
            <th>Assigned to</th>
            <th>Created by</th>
            <th>Overdue</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model)
        {
            <tr id="todo-@task.ToDoId">
                <td>@task.Description</td>
                <td>@task.DueDate.ToShortDateString()</td>
                <td>@task.CategoryId</td>
                <td>@task.StatusId</td>
                <td>@task.AssignedTo</td>
                <td>@task.CreatedBy</td>
                <td>
                    @if (task.Overdue)
                    {
                        <span class="badge bg-danger">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-success">No</span>
                    }
                </td>
                <td class="text-center">
                    <div class="d-flex justify-content-center gap-2">
                        <a href="@Url.Action("Edit", "ToDo", new { id = task.ToDoId })" class="btn btn-info btn-sm">Edit</a>
                        <form asp-controller="ToDo" asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this task?');">
                            <input type="hidden" name="id" value="@task.ToDoId" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
